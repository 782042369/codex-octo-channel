{
  "name": "codex-octo-channel",
  "description": "Octo IM channel for the Codex CLI: each DM, group, or thread drives its own persistent Codex session on your machine; committed answers return to Octo as text messages",
  "version": "0.3.1",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "codex-octo-channel": "lib/main.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets",
    "scripts",
    "systemd",
    "README.md",
    "LICENSE",
    "NOTICE",
    "config.example.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node lib/main.js",
    "test": "npm run typecheck && npm run build && node scripts/integration-test.mjs && node scripts/crypto-test.mjs && node scripts/shutdown-test.mjs",
    "test:codex": "node scripts/codex-online-test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "codex",
    "openai-codex",
    "codex-cli",
    "octo",
    "wukongim",
    "im",
    "channel",
    "bot",
    "chatbot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/782042369/codex-octo-channel.git"
  },
  "bugs": {
    "url": "https://github.com/782042369/codex-octo-channel/issues"
  },
  "homepage": "https://github.com/782042369/codex-octo-channel#readme",
  "author": "782042369",
  "license": "Apache-2.0",
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.9.3"
  }
}
